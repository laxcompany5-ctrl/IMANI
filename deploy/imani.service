[Unit]
Description=IMANI Security Intelligence Console (gunicorn)
After=network.target

[Service]
# Adjust User/Group and paths to match your server.
User=imani
Group=imani
WorkingDirectory=/opt/imani
EnvironmentFile=/opt/imani/.env
ExecStart=/opt/imani/.venv/bin/gunicorn --config gunicorn.conf.py wsgi:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=3

# Basic hardening.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
