# IMANI environment configuration — copy to `.env` and edit.
# NEVER commit the real .env (it is git-ignored).

# --- Core ---------------------------------------------------------------
# "production" enables HTTPS-only cookies, ProxyFix and the secret-key guard.
IMANI_ENV=production

# A long, random value. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
IMANI_SECRET_KEY=change-me-to-a-long-random-string

# Where the SQLite database lives (defaults to ./instance/imani.sqlite3).
# IMANI_DATABASE=/opt/imani/instance/imani.sqlite3

# --- Seeded administrator (used only by `flask seed`) -------------------
IMANI_ADMIN_USER=admin
IMANI_ADMIN_EMAIL=admin@your-domain
IMANI_ADMIN_PASS=change-this-password

# --- Google sign-in -----------------------------------------------------
IMANI_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
IMANI_GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
# Must match the "Authorised redirect URI" in Google Cloud Console exactly:
IMANI_GOOGLE_REDIRECT_URI=https://your-domain/auth/google/callback
# Optional: restrict sign-ins to these email domains (comma-separated).
# IMANI_GOOGLE_ALLOWED_DOMAINS=your-domain

# --- Reverse proxy ------------------------------------------------------
# Set to 1 when running behind nginx (ProductionConfig sets this already).
IMANI_BEHIND_PROXY=1

# --- Gunicorn (optional) ------------------------------------------------
# GUNICORN_BIND=127.0.0.1:8000
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=4
