# IMANI environment configuration — copy to `.env` and edit.
# NEVER commit the real .env (it is git-ignored).

# --- Core ---------------------------------------------------------------
# "production" enables HTTPS-only cookies, ProxyFix and the secret-key guard.
IMANI_ENV=production

# A long, random value. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
IMANI_SECRET_KEY=change-me-to-a-long-random-string

# Where the SQLite database lives (defaults to ./instance/imani.sqlite3).
# IMANI_DATABASE=/opt/imani/instance/imani.sqlite3

# --- Seeded administrator (used only by `flask seed`) -------------------
IMANI_ADMIN_USER=admin
IMANI_ADMIN_EMAIL=admin@your-domain
IMANI_ADMIN_PASS=change-this-password

# --- Google sign-in -----------------------------------------------------
IMANI_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
IMANI_GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
# Must match the "Authorised redirect URI" in Google Cloud Console exactly:
IMANI_GOOGLE_REDIRECT_URI=https://your-domain/auth/google/callback
# Optional: restrict sign-ins to these email domains (comma-separated).
# IMANI_GOOGLE_ALLOWED_DOMAINS=your-domain

# --- CCTV capture ingestion ---------------------------------------------
# Shared secret the capture devices send in the X-API-Key header. Leave
# unset to switch the /ingest/capture API off entirely.
# The camera-side capture agent (see agent/README.md) reads this same value.
IMANI_INGEST_API_KEY=change-me-to-a-long-random-string
# A capture scoring at or above this is attached to a known person outright;
# between the review and accept scores it is attached but flagged for
# confirmation; below both, a new person is enrolled.
IMANI_CAPTURE_ACCEPT_SCORE=85
IMANI_CAPTURE_REVIEW_SCORE=70
# Face templates kept per identity profile.
IMANI_PROFILE_MAX_FACES=5

# --- Reverse proxy ------------------------------------------------------
# Set to 1 when running behind nginx (ProductionConfig sets this already).
IMANI_BEHIND_PROXY=1

# --- Gunicorn (optional) ------------------------------------------------
# GUNICORN_BIND=127.0.0.1:8000
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=4

# --- Capture archive (Bit 11) ----------------------------------------------
# Where recorded footage is stored, and how long it is kept.
IMANI_MEDIA_ROOT=instance/media
IMANI_MEDIA_CLIP_FRAMES=24
IMANI_MEDIA_CLIP_FPS=5
# 0 keeps footage forever.
IMANI_MEDIA_RETENTION_DAYS=90

# --- HTTPS for phone cameras (Bit 13) --------------------------------------
# Phones only allow getUserMedia on https:// pages. For local LAN pairing,
# run `IMANI_HTTPS=1 IMANI_PORT=5443 python3 app.py`; a self-signed certificate
# is generated under instance/certs/. For a domain/tunnel, set the public URL
# that QR codes should advertise instead.
# IMANI_HTTPS=1
# IMANI_SSL_CERT=instance/certs/imani.crt
# IMANI_SSL_KEY=instance/certs/imani.key
# IMANI_PUBLIC_URL=https://imani.example.com
# IMANI_PUBLIC_SCHEME=https
# IMANI_PUBLIC_PORT=5443
# Seconds before an idle phone stream stops (the next frame restarts it).
# IMANI_PHONE_IDLE=10

# --- Video URL import → 4K snapshots (Bit 14) ------------------------------
# Downloaded source video, original frames, 4K frames and thumbnails.
# IMANI_VIDEO_IMPORT_ROOT=instance/video_imports
# Refuse downloads larger than this (bytes). Default 2 GiB.
# IMANI_VIDEO_IMPORT_MAX_BYTES=2147483648
# Candidate frames sampled before selection (long videos widen the interval).
# IMANI_VIDEO_IMPORT_MAX_CANDIDATES=600
# Target resolution for the upscaled copies.
# IMANI_VIDEO_4K_WIDTH=3840
# IMANI_VIDEO_4K_HEIGHT=2160
# Optional explicit ffmpeg binary; otherwise imageio-ffmpeg or PATH is used.
# IMANI_FFMPEG=/usr/bin/ffmpeg

# Development server behaviour. The reloader watches the whole project,
# including instance/video_imports, so it is off unless explicitly enabled.
# IMANI_DEBUG=1
# IMANI_RELOADER=1
